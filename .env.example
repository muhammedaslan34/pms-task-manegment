APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=pms-tasks
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-2
AWS_BUCKET=your-bucket-name
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Disk for task screenshots: "s3" (S3 / iDrive E2, configured above).
# Use "public" (local storage) only for local development without bucket credentials.
# Example iDrive E2: AWS_ENDPOINT=https://u0s6.fra3.idrivee2-53.com, AWS_DEFAULT_REGION=eu-central-2
SCREENSHOTS_DISK=s3

# Direct public URL base for screenshots (optional; only works if the bucket allows
# anonymous reads - E2 buckets are private by default). Example:
# SCREENSHOTS_PUBLIC_URL=https://u0s6.fra3.idrivee2-53.com/task-hotelme
# Leave unset to use pre-signed bucket URLs (or /media/task-images/{id} for local disks).
# SCREENSHOTS_PUBLIC_URL=

# Minutes a pre-signed screenshot URL stays valid.
SCREENSHOTS_URL_TTL=60

VITE_APP_NAME="${APP_NAME}"

# Telegram bot: new-task notifications + status buttons.
# Get the chat id by sending /start to the bot while `php artisan telegram:poll` runs.
# Webhook secret: any random string (A-Z, a-z, 0-9, _ and -), e.g. `php -r "echo bin2hex(random_bytes(32));"`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_LOCALE=en

# Remote MCP server (/mcp/tasks) - OAuth 2.1 via Laravel Passport.
# Signing keys: either run `php artisan passport:keys` on the server (writes storage/oauth-*.key,
# never commit them) or put the PEM contents here (multi-line values in double quotes).
# PASSPORT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
# PASSPORT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"

# Allowed redirect URI prefixes for MCP OAuth dynamic client registration (comma separated, or *).
# "http://localhost" allows any loopback port (localhost, 127.0.0.1, [::1]). The cursor://,
# claude:// and vscode:// schemes are always allowed (config/mcp.php custom_schemes).
# MCP_REDIRECT_DOMAINS=http://localhost,http://127.0.0.1,https://claude.ai,https://claude.com,https://www.cursor.com,https://chatgpt.com,https://vscode.dev

# First admin, created by `php artisan app:ensure-admin` (existing users are never changed)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
